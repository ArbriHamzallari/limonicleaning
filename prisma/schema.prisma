// Prisma schema for Limoni Cleaning.
// Provider is plain Postgres — works unchanged with either Vercel Postgres or Supabase,
// point DATABASE_URL at whichever one you provision (see README.md).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PropertyType {
  APARTAMENT
  AIRBNB
  VILE
  ZYRE
  BIZNES
  TJETER
}

enum CleaningType {
  STANDARD
  THEMEL
}

enum BookingStatus {
  E_RE
  KONFIRMUAR
  ANULUAR
  PERFUNDUAR
}

model Booking {
  id            String        @id @default(cuid())
  reference     String        @unique
  propertyType  PropertyType
  typology      String
  cleaningType  CleaningType
  date          DateTime      @db.Date
  time          String
  extras        String[]      @default([])
  estimatedPriceAll Int?
  name          String
  phone         String
  email         String?
  address       String?
  notes         String?
  status        BookingStatus @default(E_RE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([createdAt])
  @@map("bookings")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  subject   String?
  message   String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("contact_messages")
}

// Prompt 03: one model for every enquiry (form on any page). The two tables above are kept
// for history only; nothing writes to them any more. Don't drop them.

enum LeadStatus {
  E_RE
  KONTAKTUAR
  OFERTE_DERGUAR
  FITUAR
  HUMBUR
}

enum ContactChannel {
  WHATSAPP
  TELEFON
}

model Lead {
  id          String         @id @default(cuid())
  service     String // slug from lib/service-index.ts, or "tjeter"
  name        String
  phone       String // E.164, e.g. +355689007252
  area        String? // zona në Tiranë, free text
  message     String?
  channel     ContactChannel @default(WHATSAPP)
  pagePath    String // where the form was submitted
  utmSource   String?
  utmCampaign String?
  status      LeadStatus     @default(E_RE)
  createdAt   DateTime       @default(now())

  @@index([createdAt])
  @@map("leads")
}
