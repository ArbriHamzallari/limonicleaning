# Postgres connection string — works with either Vercel Postgres or Supabase.
# Vercel Postgres: copy the "POSTGRES_URL" value from Storage → your DB → .env.local tab.
# Supabase: Project Settings → Database → Connection string → URI (use the "pooled" one for serverless).
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
# Direct (non-pooled) connection, used only by `prisma migrate`. Neon on Vercel fills it in;
# for Supabase use the "Direct connection" string; locally, repeat DATABASE_URL.
DATABASE_URL_UNPOOLED="postgresql://user:password@host:5432/dbname?sslmode=require"

# Resend (https://resend.com): emails the business on every new lead (lib/notify.ts).
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Required. Sending address on a domain verified in Resend. Don't leave it on
# onboarding@resend.dev: Resend only delivers that to the account owner (a warning is logged).
EMAIL_FROM="Limoni Cleaning <kerkesa@limonicleaning.com>"

# Where lead notifications are sent: the Hostinger mailbox once it exists (e.g. info@limonicleaning.com),
# or a personal inbox until then.
EMAIL_TO="you@example.com"

# Base URL used for metadata, canonical tags, and sitemap generation.
NEXT_PUBLIC_SITE_URL="https://limonicleaning.com"

# Optional — GA4 Measurement ID (e.g. "G-XXXXXXXXXX"). Leave unset and no analytics script
# loads at all (no page-speed cost). Once set, lead_submitted / whatsapp_click / phone_click fire —
# see lib/analytics.ts for the event list.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# Optional: WhatsApp Cloud API notification to the owner for every new lead (lib/notify.ts).
# All four must be set, otherwise the WhatsApp notification is skipped with a log line and
# email still goes out.
# Permanent system-user access token with whatsapp_business_messaging permission.
# WHATSAPP_TOKEN=""
# ID of the sending business number (WhatsApp Manager > API setup), not the number itself.
# WHATSAPP_PHONE_NUMBER_ID=""
# The owner's WhatsApp number that receives the alert, digits with country code.
# OWNER_WHATSAPP="355689007252"
# Name of an approved template whose body has three variables: {{1}} service, {{2}} name, {{3}} phone.
# WHATSAPP_TEMPLATE_NEW_LEAD="kerkese_e_re"
# Template language code, defaults to "sq".
# WHATSAPP_TEMPLATE_LANG="sq"

# --- Booking requests (docs/booking-system.md) -------------------------------------------
# Encrypts the copy of each customer/job-sheet link token. 32+ random characters. Required in
# production (requests can't be created without it).
BOOKING_LINK_SECRET=""

# Owner panel at /admin. Create the user entry with: npm run admin:hash   (asks for a password)
# ADMIN_USERS="arbri:scrypt.16384.8.1.<salt>.<hash>"
# ADMIN_SESSION_SECRET="<32+ random characters>"

# Google Calendar (service account; share the calendar with its email, "Make changes to events").
# GOOGLE_SERVICE_ACCOUNT_EMAIL="limoni-calendar@<project>.iam.gserviceaccount.com"
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GOOGLE_CALENDAR_ID="<calendar id>@group.calendar.google.com"

# Operating settings for live holds (JSON, merged over lib/booking/settings.ts). Live holds stay
# OFF until liveHolds is true AND hours, buffer, crews and the service's duration are set.
# BOOKING_SETTINGS='{"liveHolds":false}'

# Private media storage: "s3" (S3-compatible bucket, e.g. Cloudflare R2) or "local" (dev only).
# Unset = uploads off; customers can still continue without photos or use WhatsApp.
# MEDIA_STORAGE="s3"
# S3_ENDPOINT="https://<account>.r2.cloudflarestorage.com"
# S3_REGION="auto"
# S3_BUCKET="limoni-kerkesa"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# Delete photos/videos of closed requests after N days (unset = keep until deleted by hand).
# MEDIA_RETENTION_DAYS=""

# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" to /api/cron/kerkesa (daily).
# CRON_SECRET=""
