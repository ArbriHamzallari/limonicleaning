# Postgres connection string — works with either Vercel Postgres or Supabase.
# Vercel Postgres: copy the "POSTGRES_URL" value from Storage → your DB → .env.local tab.
# Supabase: Project Settings → Database → Connection string → URI (use the "pooled" one for serverless).
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Resend (https://resend.com): emails the business on every new lead (lib/notify.ts).
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Required. Sending address on a domain verified in Resend. Don't leave it on
# onboarding@resend.dev: Resend only delivers that to the account owner (a warning is logged).
EMAIL_FROM="Limoni Cleaning <kerkesa@yourdomain.com>"

# Where lead notifications are sent. No business email exists yet (see CLAUDE.md) —
# set this to Arbri's personal/working inbox until a dedicated business address is confirmed.
EMAIL_TO="you@example.com"

# Base URL used for metadata, canonical tags, and sitemap generation.
NEXT_PUBLIC_SITE_URL="https://limonicleaning.al"

# Optional — GA4 Measurement ID (e.g. "G-XXXXXXXXXX"). Leave unset and no analytics script
# loads at all (no page-speed cost). Once set, lead_submitted / whatsapp_click / phone_click fire —
# see lib/analytics.ts for the event list.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# Optional: WhatsApp Cloud API notification to the owner for every new lead (lib/notify.ts).
# All four must be set, otherwise the WhatsApp notification is skipped with a log line and
# email still goes out.
# Permanent system-user access token with whatsapp_business_messaging permission.
# WHATSAPP_TOKEN=""
# ID of the sending business number (WhatsApp Manager > API setup), not the number itself.
# WHATSAPP_PHONE_NUMBER_ID=""
# The owner's WhatsApp number that receives the alert, digits with country code.
# OWNER_WHATSAPP="355689007252"
# Name of an approved template whose body has three variables: {{1}} service, {{2}} name, {{3}} phone.
# WHATSAPP_TEMPLATE_NEW_LEAD="kerkese_e_re"
# Template language code, defaults to "sq".
# WHATSAPP_TEMPLATE_LANG="sq"
