# Postgres connection string — works with either Vercel Postgres or Supabase.
# Vercel Postgres: copy the "POSTGRES_URL" value from Storage → your DB → .env.local tab.
# Supabase: Project Settings → Database → Connection string → URI (use the "pooled" one for serverless).
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Resend (https://resend.com) — used to email the business on every new booking/contact submission.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Verified Resend sending address (must be on a domain verified in your Resend account).
EMAIL_FROM="Limoni Cleaning <bookings@yourdomain.com>"

# Where booking/contact notifications are sent. No business email exists yet (see CLAUDE.md) —
# set this to Arbri's personal/working inbox until a dedicated business address is confirmed.
EMAIL_TO="you@example.com"

# Base URL used for metadata, canonical tags, and sitemap generation.
NEXT_PUBLIC_SITE_URL="https://limonicleaning.al"

# Optional — GA4 Measurement ID (e.g. "G-XXXXXXXXXX"). Leave unset and no analytics script
# loads at all (no page-speed cost). Once set, key CTA/booking events start firing —
# see lib/analytics.ts for the event list.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
